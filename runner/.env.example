# Runner-Secrets (lokal, NICHT committen — runner/.env ist gitignored).
# Kopiere diese Datei zu runner/.env und trage die Werte ein.

# Supabase-Projekt (gleiche URL wie im Frontend, app/.env.local → VITE_SUPABASE_URL)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# service_role-Key: Supabase-Dashboard → Project Settings → API → service_role.
# ACHTUNG: umgeht RLS. Bleibt nur hier lokal auf dem Mac, kommt NIE ins Frontend/Repo.
SUPABASE_SERVICE_ROLE_KEY=

# Private iCal-Links der Kalender (Google Kalender → Einstellungen → den
# EINZELNEN Kalender links anklicken → „Kalender integrieren" → „Geheime Adresse
# im iCal-Format"). Mehrere Kalender kommagetrennt, ohne Leerzeichen-Zwang:
# CALENDAR_ICAL_URL=https://…/arbeit/basic.ics,https://…/gesundheit/basic.ics
# Ohne Eintrag bleibt /termine am Handy leer: die im Cockpit gespeicherte URL
# liegt im localStorage des Macs, kennt also nur dieser eine Browser.
CALENDAR_ICAL_URL=

# Optional: Push-Intervall in ms (Default 60000 = 60s).
# SNAPSHOT_PUSH_MS=60000

# DataForSEO (22.09.2026): Google-Anzeigen je Lead vor dem Schreiben prüfen
# (Transparenzcenter, ~0,002 $ je Abfrage). Dieselben Werte wie in
# ~/.seo-skill/.env — fehlen sie hier, liest der Runner jene Datei. Fehlen sie
# ganz, bleibt `google_ads_aktiv` = „unbekannt" (nie „nein").
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
